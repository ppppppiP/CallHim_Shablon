  text: 
  ru: "\u0423\u0445\u0445\u0445, \u043A\u0430\u043A\u043E\u0439 \u043D\u0430\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u044B\u0439\n!\u0410
