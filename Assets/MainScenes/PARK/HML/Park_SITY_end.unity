  ru: "\u041F\u0440\u0438\u0432\u0435\u0442, \u0414\u0440\u0443\u0433!\n\u0422\u044B
    \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u043F\u0440\u0438\u0448\u0435\u043B
